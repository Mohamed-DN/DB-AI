# TNS Names Configuration for M-DN AI CMDB
# Location: Copy to $TNS_ADMIN/tnsnames.ora on Cairo container

# =============================================================================
# VirtualBox RAC - CDB (Oracle 19c)
# =============================================================================

# RAC Node 1 - CDB Root
CDBRAC_RAC1 =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL = TCP)(HOST = 192.168.56.101)(PORT = 1521))
    (CONNECT_DATA =
      (SERVICE_NAME = cdbrac)
    )
  )

# RAC Node 2 - CDB Root
CDBRAC_RAC2 =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL = TCP)(HOST = 192.168.56.102)(PORT = 1521))
    (CONNECT_DATA =
      (SERVICE_NAME = cdbrac)
    )
  )

