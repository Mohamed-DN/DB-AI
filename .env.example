# =============================================================================
# M-DN DBA AI - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values.
# For V2 Shadow Mode, also copy to .env.v2
# =============================================================================

# --- Backend & Frontend Ports ---
BACKEND_PORT=9000
FRONTEND_PORT=4002

# --- MongoDB ---
MONGODB_PORT=28017
MONGODB_HOST=localhost
MONGODB_DB=m-dn_cmdb_v2
MONGO_USERNAME=admin
MONGO_PASSWORD=your_password_here
MONGO_CONTAINER=m-dn-mongodb2

# --- Infrastructure Services ---
MONGO_EXPRESS_PORT=9081
REDIS_PORT=7379
OLLAMA_PORT=12434
QDRANT_PORT=7333
OPEN_WEBUI_PORT=4001

# --- AI Configuration ---
OLLAMA_HOST=http://localhost:12434
QDRANT_HOST=http://localhost:7333

# --- Gateway Configuration ---
# Set to "2" for V2 containers, empty for V1
GATEWAY_SUFFIX=2
GW_MILANO_PORT=3221
GW_BRATISLAVA_PORT=3222
GW_CAIRO_PORT=3223

# --- Database Ports (Direct Access) ---
PG_MILANO_DEV_PORT=6433
PG_MILANO_STG_PORT=6435
PG_BRATISLAVA_DEV_PORT=6434
ORACLE_CAIRO_PRIMARY_PORT=2521
ORACLE_CAIRO_REPLICA_PORT=2522

# --- Email Alerts (CriticalAlert Agent) ---
ALERT_EMAIL=dba-team@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=your_smtp_password

# --- Frontend (Vite) ---
VITE_API_BASE=http://localhost:9000/api
VITE_MONGO_EXPRESS_PORT=9081

# --- Security ---
# Master password for database admin connections (used by AI query execution)
DB_ADMIN_PASSWORD=your_db_admin_password_here

# CORS allowed origins (comma-separated, no spaces)
CORS_ORIGINS=http://localhost:4002,http://localhost:5173,http://127.0.0.1:4002

# --- Langfuse Observability (Optional) ---
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=your_public_key
LANGFUSE_SECRET_KEY=your_secret_key
