# Dockerfile for CheckMK Collector Agent
# Runs on central MongoDB machine to poll all CheckMK instances

FROM python:3.11-slim

WORKDIR /app

# Install dependencies
RUN pip install --no-cache-dir \
    requests \
    pymongo \
    pyyaml

# Copy collector files
COPY api_agents/workers/CheckMK_Collector/ /app/

# Set environment variables (override in docker-compose or runtime)
ENV CHECKMK_HOSTS=""
ENV CHECKMK_USER=cmkadmin
ENV CHECKMK_PASSWORD=pippopippo_1234
ENV MONGO_URI=mongodb://admin:pippopippo_1234@mongodb:27017/
ENV MONGO_DB=m-dn_cmdb_v2
ENV GRAPHITE_HOST=victoriametrics
ENV GRAPHITE_PORT=2003
ENV POLL_INTERVAL=60

# Health check
HEALTHCHECK --interval=60s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8080', timeout=5)" || exit 0

# Run collector
CMD ["python", "collector_agent.py"]
