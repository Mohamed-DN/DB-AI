# =============================================================================
# NEXI AI CMDB V2 - Environment Configuration (Shadow Mode)
# =============================================================================
# Questo file contiene le variabili d'ambiente per l'ambiente V2 (parallelo)
# Tutte le porte sono offset di +1000 rispetto al sistema V1
# =============================================================================

# --- MongoDB V2 ---
MONGODB_HOST=localhost
MONGODB_PORT=28017
MONGODB_DB=nexi_cmdb_v2
MONGO_USERNAME=admin
MONGO_PASSWORD=nexi2024
MONGO_URI=mongodb://admin:nexi2024@localhost:28017

# --- Redis V2 ---
REDIS_HOST=localhost
REDIS_PORT=7379

# --- Ollama LLM V2 ---
OLLAMA_HOST=http://localhost:12434
OLLAMA_MODEL=llama3:8b

# --- Qdrant Vector DB V2 ---
QDRANT_HOST=http://localhost:7333

# --- Web Interface V2 ---
BACKEND_PORT=9000
FRONTEND_PORT=4002

# --- Email SMTP (shared with V1) ---
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# --- Open WebUI V2 ---
OPEN_WEBUI_PORT=4001

# --- Mongo Express V2 ---
MONGO_EXPRESS_PORT=9081

# --- SSH Gateways V2 ---
GW_MILANO_PORT=3221
GW_BRATISLAVA_PORT=3222
GW_CAIRO_PORT=3223

# --- PostgreSQL V2 ---
PG_MILANO_DEV_PORT=6433
PG_MILANO_STG_PORT=6435
PG_BRATISLAVA_DEV_PORT=6434

# --- Oracle V2 ---
ORACLE_CAIRO_PRIMARY_PORT=2521
ORACLE_CAIRO_REPLICA_PORT=2522
